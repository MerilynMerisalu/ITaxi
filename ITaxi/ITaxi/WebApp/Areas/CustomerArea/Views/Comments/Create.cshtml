@using App.Resources.Areas.App.Domain.CustomerArea
@using Base.Resources
@model WebApp.Areas.CustomerArea.ViewModels.CreateCommentViewModel

@{
    ViewData["Title"] = Common.Create;
}
<link rel="stylesheet" href="@Url.Content("~/css/star-rating.css")"/>
<h1>@Common.Create</h1>

<h4>@Comment.CommentName</h4>
<hr/>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="DriveId" class="control-label"></label>
                <select asp-for="DriveId" class="form-control" asp-items="Model.Drives"
                        onchange="GetSelectedDriveId()">
                    @if (Model.Drives == null || !Model.Drives.Any())
                    {
                        <option>@Comment.NoDrives</option>
                    }
                    else
                    {
                        <option value="">@Common.PleaseSelect</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label asp-for="BookingNumber" class="control-label"></label>
                <input id="booking_number" asp-for="BookingNumber" disabled="disabled" class="form-control"></input>
                <span asp-validation-for="BookingNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StarRating" class="control-label"></label>
                <ejs-rating ejs-for="StarRating" cssClass="changeRating"
                            fullTemplate="<span class='star full'>★</span>"
                            emptyTemplate="<span class='star empty'>☆</span>">
                    
                </ejs-rating>
                <span asp-validation-for="StarRating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CommentText" class="control-label"></label>
                <textarea asp-for="CommentText" class="form-control"></textarea>
                <span asp-validation-for="CommentText" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="@Common.Create" class="btn btn-primary"/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@Common.BackToList</a>
</div>

@section Scripts {
    @{
        <script type="text/javascript">
        function GetSelectedDriveId() {
            let selectedDriveId = document.getElementById('DriveId').value;
            let bookingNumberDiv = document.getElementById('booking_number');
            
            if (selectedDriveId == null || selectedDriveId ==='@Common.PleaseSelect')
                return;
            fetch('/CustomerArea/Comments/GetBookingNumber/', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json; charset=UTF-8',
                },
                body: JSON.stringify(selectedDriveId)
            } ).then(response => response.
            text().then(data => bookingNumberDiv.value = data));
            
        }
    </script>
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}