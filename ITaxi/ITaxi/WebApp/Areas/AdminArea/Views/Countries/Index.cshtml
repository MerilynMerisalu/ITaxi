@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@model IEnumerable<App.BLL.DTO.AdminArea.CountryDTO>
@{
    ViewData["Title"] = Common.Index ;
}

<h1>@Common.Index</h1>

<p>
    <a asp-action="Create">@Common.CreateNew</a> 
    <br/>
    <a asp-action="UpdateFromAPI">@Country.UpdateCountriesList</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CountryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ISOCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataOrigin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsIgnored)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayTextFor(modelItem => item.CountryName)
            </td>
            <td>
                @Html.DisplayTextFor(modelItem => item.ISOCode)
            </td>
                <td>
                    @Html.DisplayTextFor(modelItem => item.DataOrigin)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsIgnored)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedBy)
            </td>
            <td>
                @Html.DisplayFor(model => item.UpdatedAt)
            </td>
            
            <td>
                @if (item.DataOrigin == DataOrigin.Manual)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id">@Common.Edit</a> <span>|</span>
                        <a asp-action="Delete" asp-route-id="@item.Id">@Common.Delete</a> <span>|</span>

                    }
                <a asp-action="Details" asp-route-id="@item.Id">@Common.Details</a> |
                <a asp-action="ToggleCountryIgnore" asp-route-id="@item.Id">@Common.ShowHide</a> |
               
            </td>
        </tr>
}
    </tbody>
</table>
