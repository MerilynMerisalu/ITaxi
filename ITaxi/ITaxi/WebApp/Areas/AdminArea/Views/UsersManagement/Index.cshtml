@using App.BLL.DTO.AdminArea
@using App.Domain.Identity

@using WebApp.Areas.AdminArea.ViewModels
@using Base.Resources;
@model IEnumerable<UserManagementDTO>
@{
    ViewData["Title"] = @Base.Resources.Base.Domain.Common.UsersManagement;
}

<h1>@Base.Resources.Base.Domain.Common.UsersManagement</h1>

<table class="table table-striped table-hover">
    <thead>
       <tr>
            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
            <th>@Html.DisplayNameFor(model => model.LastName)</th>
            <th>@Html.DisplayNameFor(model => model.Gender)</th>
            <th>@Html.DisplayNameFor(model => model.DateOfBirth)</th>
            <th>@Html.DisplayNameFor(model => model.PersonalIdentifier)</th>
            <th>@Html.DisplayNameFor(model => model.Role)</th>
            <th>@Html.DisplayNameFor(model => model.Country)</th>
            <th>@Html.DisplayNameFor(model => model.County)</th>
            <th>@Html.DisplayNameFor(model => model.City)</th>
            <th>@Html.DisplayNameFor(model => model.AddressOfResidence)</th>
            <th>@Html.DisplayNameFor(model => model.DriverLicenseCategories)</th>
            <th>@Html.DisplayNameFor(model => model.EmailAddress)</th>
            <th>@Html.DisplayNameFor(model => model.PhoneNumber)</th>
       </tr> 
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
          <tr>
              <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
              <td>@Html.DisplayFor(modelItem => item.LastName)</td>
              <td>@Html.DisplayFor(modelItem => item.Gender)</td>
              <td>@Html.DisplayFor(modelItem => item.DateOfBirth)</td>
              <td>@Html.DisplayFor(modelItem => item.PersonalIdentifier)</td>
              <td>@Html.DisplayTextFor(modelItem => item.Role)</td>
              <td>@Html.DisplayFor(modelItem => item.Country)</td>
              <td>@Html.DisplayFor(modelItem => item.County)</td>
              <td>@Html.DisplayFor(modelItem => item.City)</td>
              <td>@Html.DisplayFor(modelItem => item.AddressOfResidence)</td>
              <td>@Html.DisplayFor(modelItem => item.DriverLicenseCategories)</td>
              <td>@Html.DisplayFor(modelItem => item.EmailAddress)</td>
               <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="link-info link-info">@Common.Details</a> |
                    @* <button class="btn btn-primary">@Common.Edit</button> |
                    <button class="btn btn-danger">@Common.Delete</button> |
                    <button class="btn btn-secondary">@Common.IsIgnored</button> *@

                </td>
          </tr> 
          
        }
    </tbody>
</table>