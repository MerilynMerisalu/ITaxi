@using App.Resources.Areas.App_Domain.AdminArea
@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@model IEnumerable<App.BLL.DTO.AdminArea.CountyDTO>

@{
    ViewData["Title"] = Common.Index;
}

<h1>@Common.Index</h1>

<p>
    <a asp-action="Create">@Common.CreateNew</a> |
    <form method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-primary" asp-action="FetchingCountiesFromEHAK">@County.FetchCounties</button>
    </form>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.CountyName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataOrigin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CountyEHAKCode)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UpdatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsIgnored)
            </th>
        
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayTextFor(modelItem => item.Country!.CountryName)
                </td>
            
                <td>
                    @Html.DisplayFor(modelItem => item.CountyName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DataOrigin)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CountyEHAKCode)
                </td>
               
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedBy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UpdatedBy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UpdatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsIgnored)
                </td>

                <td>
                    @if (item.DataOrigin == DataOrigin.Manual)
                    {
                       
                        <a asp-action="Edit" asp-route-id="@item.Id">@Common.Edit</a>
                        <span>|</span>
                        <a asp-action="Delete" asp-route-id="@item.Id">@Common.Delete</a>

                        <span>|</span>
                
                    }
                    <form method="post">
                        <button type="submit" asp-action="ShowHide" 
                        asp-route-id="@item.Id" class="btn btn-link p-0 align-baseline"
                        formmethod="post">
                            @(item.IsIgnored ? Common.Show : Common.Hide)
                    </button> |
                    </form>
                    
                    <a asp-action="Details" asp-route-id="@item.Id">@Common.Details</a> |
                
                </td>
            </tr>
        }
    </tbody>
</table>


}