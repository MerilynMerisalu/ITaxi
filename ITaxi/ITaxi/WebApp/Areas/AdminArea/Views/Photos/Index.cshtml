@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@model IEnumerable<App.BLL.DTO.AdminArea.PhotoDTO?>

@{
    ViewData["Title"] = Common.Index;
}

<h1>@Common.Index</h1>

<p>
    <a asp-action="Create">@Common.CreateNew</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model!.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.FileName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.PhotoFullPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.PhotoURL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.ThumbnailFullPath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.ThumbnailRelativePath)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.DirectoryTitleId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.FileNameInDirectory)
            </th>
            @{
                var isVehicle = Model.Any(p => p.VehicleId != null);
                var isDriver = Model.Any(p => p.DriverId != null);
                var isAdmin = Model.Any(p => p.AdminId != null);
                var IsCustomer = Model.Any(p => p.CustomerId != null);
            }
            <th>
                @Html.DisplayNameFor(model => model!.Vehicle!.VehicleIdentifier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.Admin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.Driver)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.CreatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.UpdatedBy)
            </th>
            <th>
                @Html.DisplayNameFor(model => model!.UpdatedAt)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item!.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.FileName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.PhotoFullPath)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.PhotoURL)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.ThumbnailFullPath)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.ThumbnailRelativePath)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.DirectoryTitleId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.FileNameInDirectory)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.Vehicle!.VehicleIdentifier)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.Admin!.AppUser!.FirstAndLastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.Driver!.AppUser!.FirstAndLastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.CreatedBy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.CreatedAt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.UpdatedBy)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item!.UpdatedAt)
                </td>

                <td>
                    @if (item?.VehicleId != null)
                    {
                        <a asp-action="Details" asp asp-route-vehicleId="@item!.VehicleId">@Common.Details</a> <span>|</span>
                        <a asp-action="Delete" asp-route-vehicleId="@item!.VehicleId">@Common.Delete</a>
                    }
                    
                    
                   

                </td>
            </tr>
        }
    </tbody>
</table>