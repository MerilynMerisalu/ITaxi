@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@model WebApp.Areas.AdminArea.ViewModels.DetailsDeletePhotoViewModel

@{
    Layout = Layout;
    
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta name="viewport" content="width=device-width"/>
    <title>Delete</title>
</head>
<body>

<h3>@Common.AreYouSureYouWantToDeleteThis</h3>
<div>
    <h4>@Photo.PhotoName</h4>
    <hr/>
    <partial name="AdminArea/PartialViews/_DetailsDeletePhoto" model="Model"/>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id"/>
        <input type="submit" value="@Common.Delete" class="btn btn-danger"/> |
            @if(Model.IsVehicle && Model.VehicleId.HasValue)
                {
                    <a asp-controller="Vehicles" asp-action="ChooseView" asp-route-id="@Model.VehicleId.Value">@Photo.BackToGallery</a> 
                }
                |
        <a asp-action="Index">@Common.BackToList</a>
    </form>
</div>
</body>
</html>