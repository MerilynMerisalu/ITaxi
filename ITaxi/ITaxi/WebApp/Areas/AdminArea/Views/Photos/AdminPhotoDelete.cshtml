@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@model WebApp.Areas.AdminArea.ViewModels.DetailsDeleteAdminPhotoViewModel

@{
    Layout = Layout;
    
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta name="viewport" content="width=device-width"/>
    <title>@Common.Delete</title>
</head>
<body>

<h3>@Common.AreYouSureYouWantToDeleteThis</h3>
<div>
    <h4>@Photo.PhotoName</h4>
    <hr/>
    <partial name="AdminArea/PartialViews/_DetailsDeleteAdminPhoto" model="Model"/>

    <form asp-action="AdminPhotoDelete">
        <input type="hidden" asp-for="Id" />
           <input type="hidden" asp-for="AdminId" />
        <input type="submit" value="@Common.Delete" class="btn btn-danger"/> |
            
        <a asp-action="Index">@Common.BackToList</a>
    </form>
</div>
</body>
</html>