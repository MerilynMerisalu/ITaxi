@using System.Text.Json
@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@using WebApp.Areas.AdminArea.ViewModels

@model VehicleGalleryAdminViewModel

@{
    var id = JsonSerializer.Serialize(Model.Id);
    var json = JsonSerializer.Serialize(Model.Photos);
}
<p>
    <a asp-area="AdminArea" asp-controller="Photos" asp-action="VehicleImagesUpload" asp-route-id="@Model.Id">@Common.CreateNew</a>
</p>

<div id="gallery" class="gallery-view" >
    @foreach (var item in Model.Photos!)
    {
        <div class="image-container">
            <a data-fslightbox="gallery"
               href="@item!.PhotoURL"
               data-caption="@item.FileName"
               class="a">
                <img src="@item.ThumbnailRelativePath"
                     alt="@item.FileName"
                     class="image" />
            </a>
            <div class="buttons">
                <a asp-area="AdminArea" asp-controller="Photos" asp-action="Edit" asp-route-id="@item.Id">@Gallery.Upload</a>
                <a asp-area="AdminArea" asp-controller="Photos" asp-action="Delete" asp-route-id="@item.Id">@Common.Delete</a>
            </div>

        </div>
        
    }
</div>


<script type="text/javascript">
    let photos =@Html.Raw(json)

    document.addEventListener("DOMContentLoaded", function () {

        //refreshFsLightBox();
        //fsLightBox.open();
        setTimeout(() => {
            // Ava galerii ja näita esimest pilti
            fsLightboxInstances["gallery"].open(0);
        }, 150);

        fsLightBox.props.sources = photos.map(x => x.PhotoURL);
        fsLightBox.props.thumbs = photos.map(x => x.ThumbnailRelativePath);
        fsLightBox.props.captions = photos.map(x => x.FileName);
        //fsLightBox.props.showThumbsOnMount = true;
    })
</script>