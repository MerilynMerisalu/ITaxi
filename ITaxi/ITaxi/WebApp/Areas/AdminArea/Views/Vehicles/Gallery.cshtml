@using WebApp.Areas.AdminArea.ViewModels

@model VehicleGalleryAdminViewModel
@{
    var json = System.Text.Json.JsonSerializer.Serialize(Model.photos);
}
<table class="table" border="0">
    <thead>
        <tr>
            <th>
                
            </th>

           
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.photos)
        {
            <tr>
                <td>
                    <a data-fslightbox="gallery" 
                       data-thumb="@item.ThumbnailRelativePath"
                       href="@item.PhotoURL">
                       <div>@item.FileName <br/>
                           <img src="@item.ThumbnailRelativePath"/>
                       </div></a>
                </td>

            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    let photos=@Html.Raw(json)

    document.addEventListener("DOMContentLoaded", function() {

        //refreshFsLightBox();
        //fsLightBox.open();
        
        let lightBox = new FsLightbox();
        lightBox.props.sources = photos.map(x => x.PhotoURL);
        lightBox.props.thumbs = photos.map(x => x.ThumbnailRelativePath);
        lightBox.props.captions = photos.map(x => x.FileName);
        lightBox.props.showThumbsOnMount = true;
        lightBox.open();
    })
</script>