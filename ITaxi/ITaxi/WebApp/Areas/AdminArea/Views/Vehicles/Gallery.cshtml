@using System.Text.Json
@using App.Resources.Areas.App.Domain.AdminArea
@using Base.Resources
@using System.Text.Json.Serialization
@using WebApp.Areas.AdminArea.ViewModels

@model VehicleGalleryAdminViewModel

@{
    var options = new JsonSerializerOptions
    {
        ReferenceHandler = ReferenceHandler.Preserve,
        WriteIndented = true
    };
    var json = JsonSerializer.Serialize(Model.Photos, options);
}
<p>
   <a asp-area="AdminArea" asp-controller="Photos" asp-action="VehicleImagesUpload" asp-route-id="@Model.Id">@Common.CreateNew</a>
</p>

<p>
    <b class="title">@Model.VehicleIdentifier</b>
</p>

<div id="gallery" class="gallery-view" >
    @foreach (var item in Model.Photos!)
    {
        <div class="image-container">
            <a data-fslightbox="gallery"
               href="@item!.PhotoURL"
               data-caption="@Model.FormattedTitle"
               class="a">
                <img src="@item.ThumbnailRelativePath"
                     alt="@Model.FormattedTitle"
                     class="image" />
            </a>
            <form method="post" enctype="multipart/form-data" 
                asp-area="AdminArea"
                asp-controller="Photos"
                asp-action="UpdateVehicleImageAsync"
                asp-route-id="@item.VehicleId"
                asp-route-vehicleImageId="@item.Id"
                asp-route-vehicleId="@item.VehicleId"
            >
            <div class="buttons">
                <label for="fileInput_@item.Id" class="btn btn-primary">
                    <i class="bi bi-upload"></i> @Gallery.Upload
                </label>
                    <input type="file" id=fileInput_@item.Id name="file" class="input" onchange="this.form.submit();" />

                <a asp-area="AdminArea"
                   asp-controller="Photos"
                   asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-danger">
                    <i class="bi bi-trash"></i> @Common.Delete
                </a>
            </div>
            </form>
        </div>
        
    }
</div>


<script type="text/javascript">
    let photos =@Html.Raw(json)

    document.addEventListener("DOMContentLoaded", function () {

        //refreshFsLightBox();
        //fsLightBox.open();
        setTimeout(() => {
            // Ava galerii ja näita esimest pilti
            fsLightboxInstances["gallery"].open(0);
        }, 150);

        fsLightBox.props.sources = photos.map(x => x.PhotoURL);
        fsLightBox.props.thumbs = photos.map(x => x.ThumbnailRelativePath);
        fsLightBox.props.captions = photos.map(x => x.FileName);
        //fsLightBox.props.showThumbsOnMount = true;
    })
     
   
</script>