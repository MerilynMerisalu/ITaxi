@using System.Net
@using App.Resources.Areas.App.Domain.AdminArea

@model WebApp.Areas.AdminArea.ViewModels.GalleryViewModel

@{
    ViewData["Title"] = Gallery.GalleryName;
}

<h1>@Gallery.VehicleName</h1>

<h3>@Model.VehicleIdentifier</h3>
<form method="post" enctype="multipart/form-data" asp-area="AdminArea"
      asp-controller="Vehicles" asp-action="Upload">
    <div class="form-group">
        <div class="col-md-10">
            <p>@Upload.UploadRestictions</p>
            <input name="files" class="btn-outline-primary" type="file" multiple />
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            <button class="btn-primary" asp-area="AdminArea" asp-controller="Vehicles" asp-action="Upload" asp-route-id="@Model.Id">@Upload.UploadButtonText</button>
        </div>
    </div>
</form>

