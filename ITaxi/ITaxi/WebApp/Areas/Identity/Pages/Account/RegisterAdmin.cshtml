@page
@using App.Enum.Enum
@using App.Resources.Areas.Identity.Pages.Account
@using Base.Resources

@model RegisterAdminModel
@{
    ViewData["Title"] = AdminRegister.RegisterAdmin;
}

<h1>@AdminRegister.RegisterAdmin</h1>

<div class="row">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>@Register.CreateANewAccount</h2>
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="form-control" alt="@AdminRegister.EnterYourEmailAddressHere"
                       placeholder="@AdminRegister.EnterYourEmailAddressHere" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.FirstName"></label>
                <input asp-for="Input.FirstName" class="form-control" alt="@AdminRegister.EnterYourFirstNameHere"
                       placeholder="@AdminRegister.EnterYourFirstNameHere" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.LastName"></label>
                <input asp-for="Input.LastName" class="form-control" alt="@AdminRegister.EnterYourLastNameHere"
                       placeholder="@AdminRegister.EnterYourLastNameHere" />
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Gender"></label>
                <select id="gender-value" asp-for="Input.Gender" class="form-control" asp-items="Html.GetEnumSelectList<Gender>()">
                    <option>@Common.PleaseSelect</option>
                </select>
                <span asp-validation-for="Input.Gender" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.DateOfBirth"></label>
                <input id="date_value" type="date" asp-for="Input.DateOfBirth"
                       class="form-control"
                       data-error-message="@Register.DateOfBirthInvalid"
                       data-age-error-message="@Register.MinimumRegistrationAgeError"
                       alt="@AdminRegister.EnterYourDateOfBirthHere"
                       onchange="BirthDateValidation(this)" />
                <span id="error-display" class="text-danger"></span>
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.PersonalIdentifier"></label>
                <input inputmode="numeric" type="text" asp-for="Input.PersonalIdentifier" data-error-message="@Common.RequiredAttributeErrorMessage"
                data-length-error-message="@Common.ErrorMessageStringLengthMinMax" 
                data-gender-mismatch-error-message="@Register.GenderError"
                data-only-digits-error-message="@Common.ErrorMessageOnlyDigits"
                data-choose-gender-first-error-message="@Register.ChooseGenderError"
                data-enter-dob-first-error-message="@Register.EnterDateOfBirth"
                data-selected-date-mismatch-personal-identifier-code-error-message="@Register.PersonalIdentifierDateOfBirthInvalid"
                data-invalid-personal-identication-code-error-message=@Register.PersonalIdentificationCodeControlDigitError"
                 class="form-control" alt="@AdminRegister.EnterYourPersonalIdentifierCodeHere"
                       placeholder="@AdminRegister.EnterYourPersonalIdentifierCodeHere"
                       minlength="11" maxlength="11" 
                       onchange="ValidatePersonalIdentifierNumber(this)" />
                
                <span class="text-danger" id="personal-identifier-error"></span>
                <span asp-validation-for="Input.PersonalIdentifier" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.CountryId"></label>
                <select asp-for="Input.CountryId" id="countryId" class="form-control" asp-items="Model.Countries"
                        onchange="CountryIdChanged(this.value)">
                    @if (Model.PreSelectedCountry == null)
                    {
                        <option value="">@Common.PleaseSelect</option>
                    }
                  

                     
                </select>
                <span asp-validation-for="Input.CountryId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.CountyId"></label>
                <select asp-for="Input.CountyId" id="countyId" class="form-control" asp-items="Model.Counties"
                        onchange="CountyIdChanged(this.value)">
                    <option value="">@Common.PleaseSelect</option>
                </select>
                <span asp-validation-for="Input.CountyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.CityId"></label>
                <select asp-for="Input.CityId" id="cityId" class="form-control" asp-items="Model.Cities">
                    <option value="">@Common.PleaseSelect</option>
                </select>
                <span asp-validation-for="Input.CityId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Address"></label>
                <input asp-for="Input.Address" class="form-control" alt="@AdminRegister.EnterYourAddressOfResidenceHere"
                       placeholder="@AdminRegister.EnterYourAddressOfResidenceHere" />
                <span asp-validation-for="Input.Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber"></label>
                <input type="tel" asp-for="Input.PhoneNumber" class="form-control" alt="@AdminRegister.EnterYourPhoneNumberHere"
                       placeholder="@AdminRegister.EnterYourPhoneNumberHere" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" alt="@AdminRegister.EnterYourPasswordHere"
                       placeholder="@AdminRegister.EnterYourPasswordHere" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control"
                       alt="@AdminRegister.ConfirmPassword" placeholder="@AdminRegister.EnterPasswordConfirmationHere" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>


            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">@Register.RegisterAccount</button>
        </form>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            <h3>@Register.LoginThirdParty</h3>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div>
                        <p>
                            @Register.NoThirdParty
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register-common.js" asp-append-version="true"></script>
}